<UserControl x:Class="AK980Studio.Pages.LightingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AK980Studio.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Lighting" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Backlight effects run on the keyboard itself, so they keep working after you close this app or unplug."/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Effect" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="ModePanel"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Tuning" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <c:LabeledSlider x:Name="BrightnessSlider" Label="Brightness" Minimum="0" Maximum="5" Integer="True" Format="{}{0:0} / 5" ValueChanged="Setting_Changed"/>
                            <c:LabeledSlider x:Name="SpeedSlider" Label="Speed" Minimum="0" Maximum="5" Integer="True" Format="{}{0:0} / 5" ValueChanged="Setting_Changed"/>
                            <StackPanel x:Name="DirectionRow" Margin="0,8,0,0">
                                <TextBlock Text="Direction" Foreground="{DynamicResource Fg1}" Margin="0,0,0,6"/>
                                <WrapPanel x:Name="DirectionPanel"/>
                            </StackPanel>
                            <CheckBox x:Name="RainbowBox" Content="Rainbow colors instead of a single color" Margin="0,10,0,0" Click="Setting_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Save current as preset" Click="SavePreset_Click"/>
                                <TextBlock Text="Presets" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="NoPresets" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="No presets yet. Dial in an effect and save it here for one-click recall."/>
                            <WrapPanel x:Name="PresetPanel" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Lights the firmware keeps to itself" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="These have no software command (checked against every command in the stock driver), only key combos on the keyboard:"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource Kbd}"><TextBlock Text="Fn + Z" Style="{StaticResource KbdText}"/></Border>
                                <TextBlock Grid.Column="1" Text="Logo light (next to the arrow keys) on / off" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Style="{StaticResource Kbd}"><TextBlock Text="Fn + Del" Style="{StaticResource KbdText}"/></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Screen on / off" VerticalAlignment="Center"/>
                                <Border Grid.Row="2" Style="{StaticResource Kbd}"><TextBlock Text="Fn + X" Style="{StaticResource KbdText}"/></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="All lights on / off (per the AK980 V2 PRO manual)" VerticalAlignment="Center"/>
                                <Border Grid.Row="3" Style="{StaticResource Kbd}"><TextBlock Text="—" Style="{StaticResource KbdText}"/></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="Red Fn key while charging and the Num Lock key highlight are drawn by the firmware on top of every effect; there's no switch for them."/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <c:ColorPicker x:Name="Picker"/>
                            <TextBlock x:Name="ColorNote" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox x:Name="LiveBox" Content="Apply changes instantly" Click="Live_Click"/>
                            <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="Apply to keyboard" Margin="0,10,0,0" Padding="14,9" Click="Apply_Click"/>
                            <CheckBox x:Name="RestoreBox" Content="Re-apply on connect" ToolTip="Send this effect again whenever the keyboard is plugged in" Margin="0,10,0,0" Click="Restore_Click"/>
                            <TextBlock x:Name="ApplyStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
